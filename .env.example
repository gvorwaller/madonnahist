# madonnahist environment variables.
# Copy to .env and fill in real values for local dev.
# Production .env lives on the droplet at /opt/madonnahist/.env (mode 600, root:root).

# --- Runtime (loaded by the SvelteKit web app process) ---
PGHOST=127.0.0.1
PGPORT=5434
PGDATABASE=madonnahist
PGUSER=madonnahist_app
PGPASSWORD=

# --- Migration-only (loaded by backend/db/migrate_pg.sh, NOT by the web app) ---
# Owner role for DDL + grants. Separate from runtime PGPASSWORD.
MIGRATION_PGUSER=madonnahist_owner
MIGRATION_PGPASSWORD=

# --- Worker credentials (reserved; not used until OCR worker lands) ---
WORKER_PGUSER=madonnahist_worker
WORKER_PGPASSWORD=

# --- App secrets ---
# AUTH_SECRET is now also read by the enrichment worker's pdf_export job type
# (backend/workers/enrichment-worker.ts) to sign/verify the short-lived
# render token used for headless-Chromium PDF rendering
# (src/lib/server/render-token.ts) — it must be a real, non-empty value on
# any box that runs pdf_export, not just a placeholder.
AUTH_SECRET=
PORT=5176
NODE_ENV=development

# --- Worker: pdf_export (Phase H — PDF/print export), both optional ---
# MADONNAHIST_INTERNAL_URL: base URL the enrichment worker's headless
# Chromium loads the book route from to render a PDF. Defaults to
# http://127.0.0.1:3002 (the production app's own loopback address) if unset
# — only needs to be set explicitly for local/test runs against a dev server
# on a different port (e.g. http://127.0.0.1:5177).
# MADONNAHIST_INTERNAL_URL=http://127.0.0.1:3002
#
# MADONNAHIST_CHROMIUM_PATH: explicit path to a Chromium executable for
# playwright-core to launch. Leave unset to use playwright-core's own
# bundled/downloaded browser (see README/deploy notes for the one-time
# `npx playwright-core install chromium` the droplet needs).
# MADONNAHIST_CHROMIUM_PATH=
