# madonnahist environment variables.
# Copy to .env and fill in real values for local dev.
# Production .env lives on the droplet at /opt/madonnahist/.env (mode 600, root:root).

# --- Runtime (loaded by the SvelteKit web app process) ---
PGHOST=127.0.0.1
PGPORT=5434
PGDATABASE=madonnahist
PGUSER=madonnahist_app
PGPASSWORD=

# --- Migration-only (loaded by backend/db/migrate_pg.sh, NOT by the web app) ---
# Owner role for DDL + grants. Separate from runtime PGPASSWORD.
MIGRATION_PGUSER=madonnahist_owner
MIGRATION_PGPASSWORD=

# --- Worker credentials (reserved; not used until OCR worker lands) ---
WORKER_PGUSER=madonnahist_worker
WORKER_PGPASSWORD=

# --- App secrets ---
AUTH_SECRET=
PORT=5176
NODE_ENV=development
