# madonnahist local test environment.
# Copy to .env.test before running the test DB scripts.
#
# Safety rules:
# - Never use port 5433 (BTC-dashboard) or 5435 (production tunnel).
# - Never use PGDATABASE=madonnahist for local tests.
# - Keep production DigitalOcean Spaces credentials out of this database.

MADONNAHIST_ENV=test
MADONNAHIST_OBJECT_STORE=local
MADONNAHIST_LOCAL_OBJECT_STORE_DIR=.local/object-store-test

PGHOST=127.0.0.1
PGPORT=15434
PGDATABASE=madonnahist_test
PGUSER=madonnahist_app
PGPASSWORD=local-test-app-password

MIGRATION_PGUSER=madonnahist_owner
MIGRATION_PGPASSWORD=local-test-owner-password

WORKER_PGUSER=madonnahist_worker
WORKER_PGPASSWORD=local-test-worker-password

AUTH_SECRET=local-test-auth-secret
PORT=5177
NODE_ENV=test
